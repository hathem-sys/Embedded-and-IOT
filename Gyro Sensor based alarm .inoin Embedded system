
#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>

Adafruit_MPU6050 mpu;

const int BUZZER_PIN = 18;  

const float GYRO_THRESHOLD = 1.0; 

const unsigned long ALARM_HOLD_MS = 1000;

unsigned long lastTriggerTime = 0;

void setup() {
  Serial.begin(115200);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  Wire.begin(21, 22);

  if (!mpu.begin()) {
    Serial.println("Could not find a valid MPU6050 sensor. Check wiring!");
    while (1) {
      delay(10);
    }
  }

  Serial.println("MPU6050 initialized successfully.");

  mpu.setAccelerometerRange(MPU6050_RANGE_4_G);
  mpu.setGyroRange(MPU6050_RANGE_500_DEG);
  mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);

  delay(100);
}

void loop() {
  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);

  float gx = abs(g.gyro.x);
  float gy = abs(g.gyro.y);
  float gz = abs(g.gyro.z);

  if (gx > GYRO_THRESHOLD || gy > GYRO_THRESHOLD || gz > GYRO_THRESHOLD) {
    lastTriggerTime = millis();
    digitalWrite(BUZZER_PIN, HIGH);
    Serial.printf("Motion detected! X: %.2f, Y: %.2f, Z: %.2f rad/s\n", gx, gy, gz);
  } else {
    if (millis() - lastTriggerTime > ALARM_HOLD_MS) {
      digitalWrite(BUZZER_PIN, LOW);
    }
  }

  delay(50);
}
